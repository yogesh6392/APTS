# ==============================================================================
# APTS - Environment Configuration Template
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
DEBUG=False

# Database Storage
DATABASE_URL=sqlite:///portal.db
STORAGE_DIR=./uploads

# Security & Session Authentication
SESSION_SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
SESSION_EXPIRY_DAYS=7
PBKDF2_ITERATIONS=100000

# Initial Root Administrator Setup (Generated on first run if database is fresh)
INITIAL_ADMIN_EMAIL=admin@univ.edu
INITIAL_ADMIN_PASSWORD=Admin@2026!

# Institution Profile
INSTITUTION_NAME=Department of Computer Science & Engineering
ACCREDITATION_STANDARD=University B.Tech Curriculum Standard
TERM_NAME=Spring 2026 Capstone Evaluation

